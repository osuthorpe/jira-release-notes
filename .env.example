# See README.md for step-by-step instructions on getting each of these values.

# OpenAI (Required - writes the release notes)
OPENAI_API_KEY=your-openai-api-key

# JIRA (Required to pull tickets automatically)
JIRA_SERVER=https://your-domain.atlassian.net
JIRA_USERNAME=your-email@company.com
JIRA_API_TOKEN=your-jira-api-token
# Advanced: override the default ticket query (project BPD, label Release_Notes)
# JIRA_JQL_QUERY=project = "BPD" AND labels = Release_Notes ORDER BY key DESC

# Zendesk (Optional - creates a DRAFT article in the Help Center)
ZENDESK_SUBDOMAIN=your-subdomain
ZENDESK_EMAIL=your-email@company.com
ZENDESK_API_TOKEN=your-zendesk-api-token
ZENDESK_SECTION_ID=200825397
# Only needed if your Help Center requires a permission group on articles
# ZENDESK_PERMISSION_GROUP_ID=1234567

# Slack (Optional - posts the Zendesk draft link for review)
# SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
# SLACK_CHANNEL=C03BD30JG58
