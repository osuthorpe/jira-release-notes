# JIRA Configuration (Optional - if not provided, will use CSV files from jira-exports/)
# JIRA_SERVER=https://your-domain.atlassian.net
# JIRA_USERNAME=your-email@company.com
# JIRA_API_TOKEN=your-jira-api-token

# Optional: Custom JQL query for fetching issues (only used if JIRA API is configured)
# If not set, will use default query for recent releases
# JIRA_JQL_QUERY=project = "YOUR_PROJECT" AND fixVersion in releasedVersions() AND updated >= -7d ORDER BY updated DESC

# Zendesk Configuration (Optional - if not provided, HTML files will be saved locally)
# ZENDESK_SUBDOMAIN=your-subdomain
# ZENDESK_EMAIL=your-email@company.com
# ZENDESK_API_TOKEN=your-zendesk-api-token
# ZENDESK_SECTION_ID=123456789

# OpenAI Configuration (Required)
OPENAI_API_KEY=your-openai-api-key